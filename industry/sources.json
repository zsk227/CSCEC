    {
      "id": "hb-tenders-digital-construction",
      "name": "湖北公共资源交易 · 数智建造标讯",
      "kind": "json_list",
      "config": {
        "url": "https://www.hbggzy.cn/inteligentsearch/rest/esinteligentsearch/getFullTextDataNew",
        "method": "POST",
        "bodyJson": {
          "pn": 0,
          "rn": 12,
          "wd": "",
          "fields": "title;content",
          "cnum": "001",
          "sort": "{\"webdate\":0}",
          "cl": 1500,
          "highlights": "title",
          "noParticiple": "1",
          "isBusiness": "1",
          "condition": [
            {
              "fieldName": "categorynum",
              "equalList": [
                "003001002",
                "003001003",
                "003001004",
                "003001005",
                "003001006",
                "003002001",
                "003002002",
                "003002003",
                "003002004"
              ]
            },
            {
              "fieldName": "xiaqucode",
              "equal": "42",
              "isLike": true,
              "likeType": 2
            }
          ]
        },
        "itemsPath": "result.records",
        "titlePaths": [
          "title"
        ],
        "publishedAtPath": "webdate",
        "summaryPaths": [
          "content"
        ],
        "urlTemplate": "https://www.hbggzy.cn{raw:linkurl}",
        "allowUrlPrefixes": [
          "https://www.hbggzy.cn/jyxx/003001/",
          "https://www.hbggzy.cn/jyxx/003002/"
        ],
        "_aihot": {
          "initialBackfillLimit": 18
        },
        "bodyJsonVariants": [
          { "wd": "智能建造" },
          { "wd": "数智建造" },
          { "wd": "智慧工地" },
          { "wd": "建筑机器人" },
          { "wd": "工程数字化" },
          { "wd": "BIM" }
        ],
        "sortByPublishedAt": true
      },
      "tier": "T1",
      "participation_mode": "editorial",
      "interval_minutes": 90,
      "tags": [
        "湖北标讯",
        "数智建造"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
